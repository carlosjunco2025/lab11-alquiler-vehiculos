    {
      "name": "02 - Alquileres",
      "item": [
        {
          "name": "Crear alquiler valido (importe calculado)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": {{idCliente}},\n  \"idVehiculo\": {{idVehiculo}},\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"fechaFin\": \"{{fechaFin}}\"\n}"
            },
            "url": "{{baseUrlAlquiler}}/api/alquileres"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fmt = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');",
                  "const hoy = new Date();",
                  "const inicio = new Date(hoy); inicio.setDate(inicio.getDate() + 1);",
                  "const fin = new Date(hoy); fin.setDate(fin.getDate() + 4);",
                  "pm.collectionVariables.set('fechaInicio', fmt(inicio));",
                  "pm.collectionVariables.set('fechaFin', fmt(fin));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('idAlquiler', body.id);",
                  "pm.test('Estado ACTIVO', function () { pm.expect(body.estado).to.eql('ACTIVO'); });",
                  "pm.test('Importe = dias x tarifa', function () {",
                  "  const dias = Math.round((new Date(body.fechaFin) - new Date(body.fechaInicio)) / 86400000);",
                  "  pm.expect(body.importeEstimado).to.be.closeTo(body.tarifaDiaria * dias, 0.01);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener alquiler por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrlAlquiler}}/api/alquileres/{{idAlquiler}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",

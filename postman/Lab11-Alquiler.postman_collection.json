          "name": "Actualizar alquiler (nuevas fechas)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": {{idCliente}},\n  \"idVehiculo\": {{idVehiculo}},\n  \"fechaInicio\": \"{{fechaInicioEdit}}\",\n  \"fechaFin\": \"{{fechaFinEdit}}\",\n  \"tarifaDiaria\": 100.00\n}"
            },
            "url": "{{baseUrlAlquiler}}/api/alquileres/{{idAlquiler}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fmt = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');",
                  "const hoy = new Date();",
                  "const inicio = new Date(hoy); inicio.setDate(inicio.getDate() + 2);",
                  "const fin = new Date(hoy); fin.setDate(fin.getDate() + 6);",
                  "pm.collectionVariables.set('fechaInicioEdit', fmt(inicio));",
                  "pm.collectionVariables.set('fechaFinEdit', fmt(fin));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Importe recalculado', function () { pm.expect(pm.response.json().importeEstimado).to.eql(400); });"
                ]
